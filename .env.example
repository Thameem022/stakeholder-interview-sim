# Required
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sis

# AI: Amazon Bedrock, direct (SR-2026-052 SEC-AI-001).
# NO AWS KEYS IN THIS FILE. Credentials come from the standard AWS chain:
#   - server: IAM Roles Anywhere (credential_process profile) or vault-issued
#     STS credentials for the dedicated least-privilege role; see
#     deploy/WPI_DEPLOY.md, "AWS credentials for Bedrock"
#   - development: your own SSO / assumed-role profile in a DEV account
#     (AWS_PROFILE=...), never production credentials
AWS_REGION=us-east-1
BEDROCK_SCORING_MODEL=anthropic.claude-opus-5-5
BEDROCK_SCORING_FALLBACK_MODEL=anthropic.claude-sonnet-5-5
BEDROCK_ENRICHMENT_MODEL=anthropic.claude-sonnet-5-5
BEDROCK_SCORING_EFFORT=high
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024
BEDROCK_SPEECH_MODEL_ID=amazon.nova-sonic-v1:0
NOVA_SONIC_STREAM_RENEW_SECONDS=420
REALTIME_MAX_SESSION_MINUTES=30
# Bedrock Guardrail applied to persona speech, student turns and feedback.
# Required in production (the id is not a secret, but it is deployment config).
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# Server
PORT=8000

# dev | prod. "prod" makes cookies Secure and refuses to boot without a
# complete Entra configuration pointed at Microsoft's endpoint.
ENVIRONMENT=dev

# Comma-separated origins allowed to call the API cross-origin. Leave empty:
# production serves the frontend from the API's own origin, and development
# falls back to the Vite dev server. "prod" refuses to boot with a localhost
# origin listed here.
CORS_ALLOW_ORIGINS=

# Research participation (IRB-27-0033). Leave false until the approved consent
# form, DPIA and Data Governance / OGC sign-off are in place. Production will
# not start with this true while the consent text is still the draft.
RESEARCH_ENABLED=false
RESEARCH_EXPORT_APPROVAL_HOURS=72

# Retention schedule (app/jobs/retention.py, run daily by the systemd timer).
# Course data from on or before RETENTION_TERM_END (YYYY-MM-DD, UTC) — interviews,
# feedback, and the sign-in <-> pseudonym mapping — is deleted
# RETENTION_COURSE_GRACE_DAYS later. Empty = no course deletion yet.
RETENTION_TERM_END=
RETENTION_COURSE_GRACE_DAYS=30
# RAG query telemetry is kept this many days, any time of term.
RETENTION_TELEMETRY_DAYS=30
# Research copies + consent are deleted after this date (the protocol's end).
# Empty = retained under the protocol.
RETENTION_RESEARCH_UNTIL=

# Security audit events (JSON lines). stdout = service journal; syslog = the
# address below (socket path, or host:port of a forwarder); none = disabled.
# The SIEM collector address is deployment configuration — never commit it.
AUDIT_LOG_SINK=stdout
AUDIT_SYSLOG_ADDRESS=/dev/log

# Sign-in: Microsoft Entra ID (OIDC) only — there are no local accounts.
# Placeholders only. Tenant and client ids come from the app registration;
# the client secret is injected from the vault / service environment and is
# never written into this file in the repository.
ENTRA_TENANT_ID=<tenant-id>
ENTRA_CLIENT_ID=<application-client-id>
ENTRA_CLIENT_SECRET=<from-the-vault>
ENTRA_REDIRECT_URI=https://<host>/api/auth/callback
ENTRA_AUTHORITY=https://login.microsoftonline.com
# Refuse sign-ins whose token carries no recognised app role (Student,
# Instructor, StudyPersonnel, ExportApprover, SupportOwner).
ENTRA_REQUIRE_APP_ROLE=true
#
# Local development without a tenant: run the mock provider
#   cd backend && uv run python -m scripts.dev_oidc_provider
# and use instead:
#   ENTRA_AUTHORITY=http://127.0.0.1:9999
#   ENTRA_TENANT_ID=00000000-0000-0000-0000-00000000dev0
#   ENTRA_CLIENT_ID=ses-local-dev
#   ENTRA_CLIENT_SECRET=not-a-secret
#   ENTRA_REDIRECT_URI=http://localhost:5173/api/auth/callback

# App session (issued after a successful Entra sign-in)
AUTH_EMAIL_DOMAIN=wpi.edu
AUTH_COOKIE_NAME=sis_session
AUTH_SESSION_DEFAULT_HOURS=12
# How stale last_seen_at may get before an authenticated request refreshes it.
AUTH_SESSION_TOUCH_INTERVAL_SECONDS=60

# Read ONCE by migration 0005, never by the application. Interview sessions
# created before authentication existed have no owner; they get assigned to
# this account. Unset falls back to the oldest account. The migration fails
# loudly rather than guessing if neither resolves.
LEGACY_SESSION_OWNER_EMAIL=
