# Required
OPENAI_API_KEY=
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sis

# OpenAI Realtime
OPENAI_REALTIME_MODEL=gpt-realtime

# Embeddings
EMBEDDING_MODEL=text-embedding-3-small

# Server
PORT=8000

# dev | prod. "prod" makes the session cookie Secure and refuses to boot while
# AUTH_TEMP_PASSWORD_MODE is still "fixed".
ENVIRONMENT=dev

# Auth
AUTH_EMAIL_DOMAIN=wpi.edu
AUTH_COOKIE_NAME=sis_session
AUTH_SESSION_REMEMBER_DAYS=30
AUTH_SESSION_DEFAULT_HOURS=12
AUTH_MIN_PASSWORD_LENGTH=12
AUTH_TEMP_PASSWORD_TTL_HOURS=24
AUTH_MAX_TEMP_PASSWORD_ATTEMPTS=10
# How stale last_seen_at may get before an authenticated request refreshes it.
AUTH_SESSION_TOUCH_INTERVAL_SECONDS=60

# Read ONCE by migration 0005, never by the application. Interview sessions
# created before authentication existed have no owner; they get assigned to
# this account. Unset falls back to the oldest account. The migration fails
# loudly rather than guessing if neither resolves.
LEGACY_SESSION_OWNER_EMAIL=

# No email is sent yet, so every registration gets the same known temporary
# password below. Switch to "random" once a mail provider is wired up.
AUTH_TEMP_PASSWORD_MODE=fixed
AUTH_DEV_TEMP_PASSWORD=7QF-42KD-XM

# Who may register while the temporary password is the fixed constant above.
# Full addresses, or a domain wildcard. EMPTY MEANS NOBODY — opening this up
# is meant to be a deliberate act, since anyone who knows the fixed password
# could otherwise claim any address on the domain.
AUTH_REGISTRATION_ALLOWLIST=*@wpi.edu
